# Vercel Environment Variables
# These should be set in the Vercel Dashboard -> Settings -> Environment Variables

# The WebSocket URL for the signaling server
# LEAVE THIS BLANK IN DEVELOPMENT!
# If left blank, the app will dynamically use your current IP address (e.g. 192.168.x.x)
# which is required for `bun dev --host` to work on other devices like your phone!
VITE_WS_URL=

# Optional TURN server for strict firewall bypass (e.g. turn:global.turn.twilio.com:3478)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
