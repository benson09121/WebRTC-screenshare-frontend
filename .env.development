# Vercel Environment Variables
# These should be set in the Vercel Dashboard -> Settings -> Environment Variables

# The WebSocket URL for the signaling server
# LEAVE THIS BLANK IN DEVELOPMENT!
# If left blank, the app will dynamically use your current IP address (e.g. 192.168.x.x)
# which is required for `bun dev --host` to work on other devices like your phone!
VITE_WS_URL=
VITE_GIPHY_API_KEY=zupwDXJZO3McASNVFTD4CyYtGgcQe9T1

# TMDB application read access token used directly by the browser catalog.
# Vite embeds this value in the public client bundle. Use only a restricted,
# replaceable TMDB application token and never a user/session credential.
VITE_TMDB_READ_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiIzYmYwZWFjOTg3NGFhZGIxZDViOGE2N2JlZGJhNDA4MSIsIm5iZiI6MTc2Mzk3MzM1My44MTc5OTk4LCJzdWIiOiI2OTI0MThlOThkZTlmMzlkZDlkY2ZlNWUiLCJzY29wZXMiOlsiYXBpX3JlYWQiXSwidmVyc2lvbiI6MX0.Q8fxIEuXlSMbrHCRIaihPQvQbdEKmFmUFI16_OyIcaA
# Optional TURN server for strict firewall bypass (e.g. turn:global.turn.twilio.com:3478)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
