# Vercel Environment Variables
# These should be set in the Vercel Dashboard -> Settings -> Environment Variables

# The WebSocket URL for the signaling server (e.g. wss://your-backend.onrender.com)
VITE_WS_URL=wss://webrtc-screenshare-backend.onrender.com

# Optional TURN server for strict firewall bypass (e.g. turn:global.turn.twilio.com:3478)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
