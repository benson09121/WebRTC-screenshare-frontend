# Vercel Environment Variables
# These should be set in the Vercel Dashboard -> Settings -> Environment Variables

# The WebSocket URL for the signaling server (e.g. wss://your-backend.onrender.com)
VITE_WS_URL=

# TMDB application read access token used directly by the browser catalog.
# Vite embeds this value in the public client bundle. Use only a restricted,
# replaceable TMDB application token and never a user/session credential.
VITE_TMDB_READ_ACCESS_TOKEN=

# Optional TURN server for strict firewall bypass (e.g. turn:global.turn.twilio.com:3478)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
