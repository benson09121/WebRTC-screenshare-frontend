{
  "manifest_version": 3,
  "name": "PairBeam Vidking Sync Prototype",
  "description": "Connects PairBeam watch rooms to a Vidking player without reading or relaying its media URL.",
  "version": "0.3.1",
  "permissions": [
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.vidking.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "pairbeam-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.vidking.net/embed/*"
      ],
      "js": [
        "vidking-player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
