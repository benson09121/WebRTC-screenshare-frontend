{
  "manifest_version": 3,
  "name": "PairBeam Watch Sync",
  "description": "Synchronizes playback controls on explicitly selected PairBeam watch providers without reading or relaying media URLs.",
  "version": "0.5.1",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": [
    "https://www.vidking.net/*",
    "https://zoryva.me/*",
    "https://zoryvax.neonnexusx.games/*",
    "https://www.2embed.cc/*",
    "https://streamsrcs.2embed.cc/*",
    "https://cineby.hair/*",
    "https://videm.xyz/*",
    "https://*.videm.xyz/*",
    "https://vidcore.net/*",
    "https://*.vidcore.net/*",
    "https://vidsrc.io/*",
    "https://cloudorchestranova.com/*",
    "https://*.cloudorchestranova.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pairbeam-vidking-sync@pairbeam.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*"
      ],
      "js": ["pairbeam-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.vidking.net/*",
        "https://zoryva.me/*",
        "https://zoryvax.neonnexusx.games/*",
        "https://www.2embed.cc/*",
        "https://streamsrcs.2embed.cc/*",
        "https://cineby.hair/*",
        "https://videm.xyz/*",
        "https://*.videm.xyz/*",
        "https://vidcore.net/*",
        "https://*.vidcore.net/*",
        "https://vidsrc.io/*",
        "https://cloudorchestranova.com/*",
        "https://*.cloudorchestranova.com/*"
      ],
      "js": ["vidking-player.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
